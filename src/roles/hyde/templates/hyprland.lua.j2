for i, rule in ipairs(opacity_rules) do
	hl.window_rule({
		name = "hyde_opacity_" .. i,
		match = { class = rule.class },
		opacity = rule.opacity,
	})
end

-- Floating windows not already covered by HyDE's own float defaults
-- (see ~/.local/share/hypr/lua/window_rules.lua for what's already handled —
-- Bitwarden, KeePassXC, pavucontrol, dolphin dialogs, etc. are default HyDE rules)
local float_classes = {
	"^(Signal)$",
	"^(com.github.rafostar.Clapper)$",
	"^(app.drey.Warp)$",
	"^(net.davidotek.pupgui2)$",
	"^(yad)$",
	"^(eog)$",
	"^(io.github.alainm23.planify)$",
	"^(io.gitlab.theevilskeleton.Upscaler)$",
	"^(com.github.unrud.VideoDownloader)$",
	"^(io.gitlab.adhami3310.Impression)$",
	"^(io.missioncenter.MissionCenter)$",
}
for i, class in ipairs(float_classes) do
	hl.window_rule({
		name = "hyde_float_" .. i,
		match = { class = class },
		float = true,
	})
end

-- Keep fullscreen video/media from triggering the idle lock
local idle_inhibit_classes = {
	"^(.*celluloid.*)$",
	"^(.*mpv.*)$",
	"^(.*vlc.*)$",
	"^(.*[Ss]potify.*)$",
	"^(.*LibreWolf.*)$",
	"^(.*floorp.*)$",
	"^(.*brave-browser.*)$",
	"^(.*firefox.*)$",
	"^(.*chromium.*)$",
	"^(.*zen.*)$",
	"^(.*vivaldi.*)$",
}
for i, class in ipairs(idle_inhibit_classes) do
	hl.window_rule({
		name = "hyde_idle_inhibit_" .. i,
		match = { class = class },
		idle_inhibit = "fullscreen",
	})
end

-- Workaround for JetBrains IDE dropdown/popup flicker
hl.window_rule({
	name = "hyde_jetbrains_no_initial_focus",
	match = { class = "^(.*jetbrains.*)$", title = "^(win[0-9]+)$" },
	no_initial_focus = true,
})
