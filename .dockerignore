# Git history — not needed in build context, reduces context size
.git

# CI/CD workflows — irrelevant to image content, prevents cache invalidation on workflow-only changes
.github

# Secret files
*.env
.env
*.key
*.pem
*.p12

# OS and editor artifacts
.DS_Store
**/.DS_Store
*.swp
*.swo

# Python artifacts
__pycache__
*.pyc
*.pyo

# Node (in case any tooling uses it)
node_modules
