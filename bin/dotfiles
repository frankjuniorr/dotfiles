#!/bin/bash
set -e

# Paths
CONFIG_DIR="$HOME/.config/dotfiles"
# bin/dotfiles always lives exactly one level below the repo root, so resolve
# it structurally instead of via `git rev-parse` — this script must also work
# when there's no .git around (zip download, or an rsync loop that excludes it).
DOTFILES_DIR=$(dirname "$(dirname "$(readlink -f "$0")")")
IS_FIRST_RUN="$HOME/.dotfiles_first_run"
DOTFILES_VERSION="v1.1.1"

# Parse --mode omarchy|ubuntu, independent of the positional role/tag arg
MODE="${MODE:-}"
args=()
while [ $# -gt 0 ]; do
  case "$1" in
  --mode)
    MODE="$2"
    shift 2
    ;;
  --mode=*)
    MODE="${1#--mode=}"
    shift
    ;;
  *)
    args+=("$1")
    shift
    ;;
  esac
done
set -- "${args[@]}"

if [ -n "$MODE" ] && [ "$MODE" != "omarchy" ] && [ "$MODE" != "ubuntu" ]; then
  echo "Unknown --mode '$MODE' (expected: omarchy, ubuntu)" >&2
  exit 1
fi

# get the environment var `ROLE`.
# If `$ROLE` doens't exists, get the `$1`
TAG_NAME="${ROLE:-$1}"

if [ -z "$TAG_NAME" ]; then
  TAG_NAME=$(gum input --placeholder "all" --prompt "Role > ")
  [ -z "$TAG_NAME" ] && TAG_NAME='all'
fi

function show_header() {
  clear
  cat <<"HEADER"
    ____        __  _____ __
   / __ \____  / /_/ __(_) /__  _____
  / / / / __ \/ __/ /_/ / / _ \/ ___/
 / /_/ / /_/ / /_/ __/ / /  __(__  )
/_____/\____/\__/_/ /_/_/\___/____/

HEADER
}

function print_message() {
  local message="$1"

  gum style --bold --foreground="#FFFFFF" "$message"
}

function print_warning() {
  local message="$1"

  gum style --bold --foreground="#FFA500" --border normal --border-foreground="#FFA500" --padding "0 1" "$message"
}

function loading() {
  local title="$1"
  local command="$2"

  gum spin --title="$title" \
    --spinner.foreground="$os_color" -- sh -c "$command"
}

SUDO_KEEPALIVE_PID=""
BECOME_PASS_FILE=""

function cleanup() {
  [ -n "$SUDO_KEEPALIVE_PID" ] && kill "$SUDO_KEEPALIVE_PID" 2>/dev/null
  [ -n "$BECOME_PASS_FILE" ] && rm -f "$BECOME_PASS_FILE"
}
trap cleanup EXIT

function start_sudo_keepalive() {
  # sudo's cached ticket expires after ~15min by default. A full `all` run can
  # easily run longer than that (several AUR packages compile from source —
  # ddcui alone takes a few minutes), so anything relying on the ticket still
  # being warm later in the run (e.g. `yay -S` tasks, which never run as root
  # themselves and instead shell out to sudo internally) can start failing
  # partway through with "sudo: a password is required" once it lapses.
  # Refresh it in the background for the life of the script so it never does.
  (
    while kill -0 "$$" 2>/dev/null; do
      sudo -n -v
      sleep 60
    done
  ) &
  SUDO_KEEPALIVE_PID=$!
}

function print_stats() {
  os_pretty_name=$(grep "^PRETTY_NAME=" /etc/os-release | cut -d '=' -f2 | sed 's/"//g')
  dotfiles_stats_file="/tmp/dotfiles-stats.csv"

  echo "Dotfiles,\"$DOTFILES_VERSION\"" >"$dotfiles_stats_file"
  echo "Distro Linux,\"$os_pretty_name\"" >>"$dotfiles_stats_file"
  echo "Mode,\"${MODE:-auto}\"" >>"$dotfiles_stats_file"
  echo "Role,\"$TAG_NAME\"" >>"$dotfiles_stats_file"

  gum table --border rounded --print --file "$dotfiles_stats_file"
}

function check_dependencies() {
  if ! type gum >/dev/null 2>&1; then

    case $os_name in
    Ubuntu)
      gum_version="0.14.4"
      gum_filename="gum_${gum_version}_amd64.deb"

      echo "Installing dependencies: gum"
      wget -q -P /tmp "https://github.com/charmbracelet/gum/releases/download/v${gum_version}/${gum_filename}"
      sudo dpkg -i /tmp/${gum_filename} >/dev/null && rm -rf /tmp/${gum_filename}
      ;;
    "Arch Linux")
      sudo pacman -S --noconfirm gum
      ;;
    esac

  fi
}

function ubuntu_setup() {

  # Prime sudo's credential cache with a real, visible prompt *before* any
  # sudo call gets wrapped in `loading()` (gum spin). gum spin owns the tty
  # for its spinner animation and unreliably swallows a sudo password prompt
  # from the wrapped command — sometimes it comes through, sometimes it just
  # hangs forever with no visible output. A cached ticket means none of the
  # sudo calls below ever need to prompt while wrapped.
  sudo -v
  start_sudo_keepalive

  test -f /var/lib/apt/lists/lock && sudo rm -rf /var/lib/apt/lists/lock
  test -f /var/cache/apt/archives/lock && sudo rm -rf /var/cache/apt/archives/lock
  test -f /var/lib/dpkg/lock && sudo rm -rf /var/lib/dpkg/lock
  test -f /var/lib/dpkg/lock-frontend && sudo rm -rf /var/lib/dpkg/lock-frontend

  loading "Updating packages..." "sudo apt update && sudo apt -y upgrade"

  if ! dpkg -s git >/dev/null 2>&1; then
    loading "Installing Git" "sudo apt install -y git git-extras"
  fi

  loading "Installing Python3 dependencies" "sudo apt -y install \
        python3 \
        python3-testresources \
        python3-venv \
        python3-pip \
        python3-watchdog"

  if ! dpkg -s ansible >/dev/null 2>&1; then
    loading "Installing Ansible" "sudo apt update && \
      sudo apt install -y software-properties-common && \
      sudo apt-add-repository -y ppa:ansible/ansible && \
      sudo apt update && \
      sudo apt install -y ansible"
  fi

}

function arch_setup() {

  # See the comment in ubuntu_setup(): prime sudo here, outside of gum spin,
  # so the wrapped sudo calls below reuse the cached ticket instead of
  # risking a swallowed password prompt.
  sudo -v
  start_sudo_keepalive

  # Omarchy now ships its own pre-transaction pacman hook that flat-out
  # refuses a direct full-system-upgrade transaction ("Woah partner... This
  # looks like a direct pacman system upgrade") whenever there's anything
  # to actually upgrade — confirmed live: `yay -Syu --noconfirm` here fails
  # with "failed to commit transaction (failed to run transaction hooks)"
  # and, since this whole script runs under `set -e`, that non-zero exit
  # from `loading()` silently kills the ENTIRE `bin/dotfiles` run right here
  # — before Ansible ever starts, no matter which role/tag was requested.
  # Omarchy already owns full-system updates via `omarchy-update`/
  # `omarchy update`, so skip this step entirely under omarchy_mode instead
  # of fighting it; the targeted single/few-package `pacman -S`/`yay -S`
  # installs below and throughout the rest of this repo are unaffected —
  # confirmed the hook only blocks full-system-upgrade transactions, not
  # targeted package installs (every other pacman/yay task in this repo
  # keeps working fine).
  if [ "$MODE" = "omarchy" ]; then
    print_message "Skipping full system upgrade (Omarchy manages this itself — run 'omarchy update' separately if needed)"
  elif ! type yay >/dev/null 2>&1; then
    loading "Update System" "sudo pacman -Sy --noconfirm"
  else
    loading "Update System" "yay -Syu --noconfirm --answerclean None --answerdiff None --answeredit None"
  fi

  if ! pacman -Q python3 >/dev/null 2>&1; then
    loading "Installing Python3" "sudo pacman -S --noconfirm python3 python-virtualenv"
  fi

  if ! pacman -Q python-pip >/dev/null 2>&1; then
    loading "Installing Python3 Pip" "sudo pacman -S --noconfirm python-pip"
  fi

  if ! [ -x "$(command -v ansible)" ]; then
    loading "Installing Ansible" "sudo pacman -S --noconfirm ansible python-argcomplete"
  fi

  if ! pip3 list | grep watchdog >/dev/null 2>&1; then
    loading "Installing Python3 Watchdog" "sudo pacman -S --noconfirm python-watchdog"
  fi

  if ! pacman -Q openssh >/dev/null 2>&1; then
    loading "Installing OpenSSH" "sudo pacman -S --noconfirm openssh"
  fi
}

update_ansible_galaxy() {
  loading "Updating Ansible Galaxy" "ansible-galaxy install -r $DOTFILES_DIR/src/requirements/common.yml"
}

#########################################################
# MAIN
#########################################################

os_name=$(grep "^NAME=" /etc/os-release | cut -d '=' -f2 | sed 's/"//g')

check_dependencies

show_header

# --mode bypasses /etc/os-release detection: Omarchy is Arch-based but may not
# report NAME="Arch Linux", so an explicit --mode omarchy always takes the Arch path.
case "$MODE" in
omarchy)
  os_color="#1793D1"
  if [ "$TAG_NAME" = "all" ]; then
    arch_setup
  fi
  ;;
ubuntu)
  os_color="#E95420"
  if [ "$TAG_NAME" = "all" ]; then
    ubuntu_setup
  fi
  ;;
*)
  case $os_name in
  Ubuntu)
    os_color="#E95420"
    if [ "$TAG_NAME" = "all" ]; then
      ubuntu_setup
    fi
    ;;
  "Arch Linux" | Omarchy)
    os_color="#1793D1"
    # Omarchy reports NAME="Omarchy", not "Arch Linux" — auto-detect it here too
    # instead of requiring an explicit --mode omarchy, same effect either way.
    [ "$os_name" = "Omarchy" ] && MODE="omarchy"
    if [ "$TAG_NAME" = "all" ]; then
      arch_setup
    fi
    ;;
  *)
    print_message "Unsupported OS"
    exit 1
    ;;
  esac
  ;;
esac

print_stats

# shellcheck disable=SC2069
pushd "$DOTFILES_DIR" 2>&1 >/dev/null
update_ansible_galaxy

EXTRA_VARS_ARGS=()
if [ "$MODE" = "omarchy" ]; then
  EXTRA_VARS_ARGS=(-e '{"omarchy_mode": true}')
fi

print_message "Running playbook"
# Without NOPASSWD sudo, every `become: true` task (there are many — package
# installs across almost every role) needs a sudo password. Ansible's own
# `--ask-become-pass` interactive prompt hits a real ansible-core 2.21.x bug
# ("Duplicate become password prompt encountered") whenever the become task
# comes from a dynamically included role (include_role) — which is every task
# in this playbook, since role selection in main.yml goes through include_role.
# Prompting for the password ourselves and feeding it in as a var sidesteps
# Ansible's interactive prompt code path entirely, so the bug never triggers.
# Passed via a temp vars file (not `-e ansible_become_pass=...` on argv) so it
# never shows up in `ps aux`.
# Drain any stray bytes already sitting in the input buffer before reading
# the password. Root cause confirmed live: gum's stats-table rendering just
# above emits terminal capability queries (synchronized-output/grapheme-
# clustering escape sequences, e.g. "\e[?2026$p"); the terminal's own
# escape-sequence *response* to those queries (e.g. "\e[?2026;2$y") can
# still be in flight when this script hands control to the `read` below,
# and that whole response payload then lands inside $BECOME_PASS ahead of
# the real password. That corrupts the become-pass temp file's YAML and
# produces a very confusing failure right at Ansible startup: "Failed to
# parse inventory with 'ini' plugin ... YAML parsing failed" (either an
# "unacceptable character #x001b" or, once the ESC byte itself is stripped,
# a "did not find expected ',' or ']'" from the leftover "[?2026;2$y..."
# text) — pointing at the temp file's /tmp path, NOT actually an
# inventory/hosts.ini problem (ansible-core's extra-vars-file loader shares
# the same parser/error path as inventory parsing, so the real cause gets
# misreported as an inventory failure). A plain `while read -t 0` drain
# loop spun forever on this VM's pty (some bash/tty combinations always
# report "readable" for `-t 0`), so this uses a real bounded timeout per
# iteration instead — each pass either drains whatever is buffered or
# times out in 30ms, capped at 5 passes (~0.15s worst case when there's
# nothing to drain, the common case for a human typing at normal speed).
for _ in 1 2 3 4 5; do
  read -r -t 0.03 -n 4096 _drain 2>/dev/null || break
done

read -rs -p "BECOME password: " BECOME_PASS
echo
# Defense in depth on top of the drain above: strip any control characters
# that still made it through — a corrupted value silently breaking the
# whole playbook run is worse than trimming a rogue byte from it.
BECOME_PASS="$(printf '%s' "$BECOME_PASS" | tr -d '[:cntrl:]')"
BECOME_PASS_FILE=$(mktemp)
chmod 600 "$BECOME_PASS_FILE"
printf 'ansible_become_pass: %s\n' "$BECOME_PASS" >"$BECOME_PASS_FILE"
unset BECOME_PASS

cd "${DOTFILES_DIR}/src" >/dev/null && ansible-playbook -e "@${BECOME_PASS_FILE}" -i hosts.ini "main.yml" --tags "$TAG_NAME" "${EXTRA_VARS_ARGS[@]}"

# The git/dotfiles roles' GitHub token + SSH-signing-key tasks are gated on a
# live `op whoami` (see src/roles/{git,dotfiles}/tasks/main.yaml) rather than
# the old Ansible-Vault vars — they silently no-op when 1Password isn't
# authenticated instead of failing the whole run. Remind here so that
# silence doesn't get forgotten about, e.g. right after a fresh machine
# format. Only relevant when this run actually touched those roles.
tag_is_relevant() {
  [ "$TAG_NAME" = "all" ] && return 0
  local tag
  IFS=',' read -ra __dotfiles_tags <<<"$TAG_NAME"
  for tag in "${__dotfiles_tags[@]}"; do
    [ "$tag" = "git" ] || [ "$tag" = "dotfiles" ] && return 0
  done
  return 1
}

if tag_is_relevant && { ! command -v op >/dev/null 2>&1 || ! op whoami >/dev/null 2>&1; }; then
  print_warning "1Password not authenticated — GitHub token (gh CLI) and commit-signing config were skipped.
To finish setup: log into 1Password, enable its SSH Agent (Settings → Developer → Use the SSH Agent), make sure your SSH key is in the vault, then re-run:
  bin/dotfiles \"git\" && bin/dotfiles \"dotfiles\""
fi

# shellcheck disable=SC2069
popd 2>&1 >/dev/null

if ! [[ -f "$IS_FIRST_RUN" ]]; then
  print_message "☯ First run complete. Please reboot your computer"
  touch "$IS_FIRST_RUN"
fi
