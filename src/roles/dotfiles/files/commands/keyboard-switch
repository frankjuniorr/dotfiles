#!/bin/bash

function ubuntu_switch(){
    local layout="$1"

    case $layout in
        "pt_br")
            setxkbmap -model abnt2 -layout br -variant abnt2 -option "compose:ralt"
            ;;
        "us")
            setxkbmap -model logitech_base -layout us -variant intl -option "compose:ralt"
            ;;
        *)
            print_message "Unsupported Layout"
            exit 1
            ;;
    esac
}

function arch_switch(){
    local layout="$1"
    # HyDE's Lua migration retired userprefs.conf; keyboard settings now live
    # as hl.config({ input = {...} }) fields in ~/.config/hypr/hyprland.lua
    # (rendered by the `hyde` Ansible role). This edits the live file directly,
    # so it takes effect immediately via Hyprland's config watcher, but does
    # NOT persist across the next `bin/dotfiles hyde` run — re-run this after.
    local config_file="${HOME}/.config/hypr/hyprland.lua"

    case $layout in
        "pt_br")
            sed -i \
                -e 's/kb_layout = "us"/kb_layout = "br"/' \
                -e 's/kb_variant = "intl"/kb_variant = "abnt2"/' \
                -e 's/kb_model = "logitech_base"/kb_model = ""/' \
                "$config_file"
            ;;
        "us")
            sed -i \
                -e 's/kb_layout = "br"/kb_layout = "us"/' \
                -e 's/kb_variant = "abnt2"/kb_variant = "intl"/' \
                -e 's/kb_model = ""/kb_model = "logitech_base"/' \
                "$config_file"
            ;;
        *)
            print_message "Unsupported Layout"
            exit 1
            ;;
    esac
}

############################################################################
# MAIN
############################################################################
os_name=$(grep "^NAME=" /etc/os-release | cut -d '=' -f2 | sed 's/"//g')

layout=$(gum choose \
        --header "Choose a layout?" \
        --header.foreground=7 \
		--cursor.foreground=1 \
		--selected.foreground=1 \
		--no-show-help \
		"pt_br" "us")

case $os_name in
  "Ubuntu")
    ubuntu_switch "$layout"
    ;;
  "Arch Linux")
    arch_switch "$layout"
    ;;
  *)
    print_message "Unsupported OS"
    exit 1
    ;;
esac